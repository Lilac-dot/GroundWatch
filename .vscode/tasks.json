{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "sdcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(warning|error)\\s+\\d*:?\\s*(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Test fusion table",
      "type": "shell",
      "command": "make test",
      "group": "test"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "PC: list serial ports",
      "type": "shell",
      "command": "python3 tools/groundwatch_pc.py --list"
    },
    {
      "label": "PC: live log + plot",
      "type": "shell",
      "command": "python3 tools/groundwatch_pc.py ${input:port} --label '${input:label}'"
    },
    {
      "label": "PC: live log + cloud upload",
      "type": "shell",
      "command": "python3 tools/groundwatch_pc.py ${input:port} --cloud --label '${input:label}'"
    },
    {
      "label": "PC: demo (no board)",
      "type": "shell",
      "command": "python3 tools/groundwatch_pc.py --demo --out demo.csv"
    },
    {
      "label": "Dashboard: serve on localhost:8000",
      "type": "shell",
      "command": "python3 -m http.server 8000 --directory dashboard",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tests: replay a recording",
      "type": "shell",
      "command": "make replay && ./build/replay ${input:recording}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Serial port (run 'PC: list serial ports')",
      "default": "/dev/cu.usbserial-0001"
    },
    {
      "id": "label",
      "type": "pickString",
      "description": "What are you recording?",
      "options": [
        "",
        "background",
        "footstep",
        "digging",
        "animal"
      ]
    },
    {
      "id": "recording",
      "type": "promptString",
      "description": "Recording CSV",
      "default": "recordings/"
    }
  ]
}
